# Server
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Surplus upstream
SURPLUS_BASE_URL=https://api.surplusintelligence.ai/v1
SURPLUS_API_KEY=replace-me

# Router behavior
ROUTER_MODEL_IDS=surplus-smart-router,auto
CAPABILITY_REGISTRY_PATH=./registry/models.json
SQLITE_PATH=./data/router.sqlite
CACHE_TTL_MS=60000
REQUEST_TIMEOUT_MS=120000

# Auto-reload the capability registry when the file changes (true/false)
REGISTRY_WATCH=true

# Utility weights must add up to approximately 1.0.
UTILITY_WEIGHTS={"capability":0.45,"cost":0.25,"latency":0.10,"history":0.10,"preferences":0.10}

# Optional JSON. Examples:
# USER_PREFERENCES={"preferModels":["claude-sonnet-5"],"avoidModels":["expensive-model"],"maxInputCostPerMTok":5,"maxOutputCostPerMTok":25,"latencyBias":"balanced"}
USER_PREFERENCES={}

# jev prompt classifier (TypeSafe System One) — https://docs.typesafe.ai
# Either JEV_API_KEY or TYPESAFE_API_KEY is accepted.
# off = never call jev | shadow = record jev but let the heuristic decide | live = jev decides
# Default is shadow: there is no ground truth yet to prove jev routes better.
JEV_MODE=shadow
JEV_API_KEY=replace-me
# JEV_BASE_URL=https://api.typesafe.ai/v1
# Pin a version instead of the alias if you tune confidence thresholds.
# JEV_MODEL=jev-latest
# jev sits in front of every completion; on timeout the request falls back to the heuristic.
# JEV_TIMEOUT_MS=1500
# JEV_MAX_STATE_CHARS=12000
# Short-TTL classification cache (ms). Recurring prompts (cron jobs, retries, health pings)
# decide from cache instead of paying ~400ms per call. 0 disables. Only successes are cached.
# JEV_CACHE_TTL_MS=300000
# Just-in-time catalog widening (live mode only): also consider live Surplus models that have no
# hand-maintained registry entry, using conservative derived capability scores, so dynamic pricing
# across the full catalog is exploited. Derived entries must win on price to be picked.
# JEV_JIT_CATALOG=true
